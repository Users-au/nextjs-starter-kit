# Copy env.example (no leading dot) to .env.local in the Next.js application root.
# npm run setup creates it with a private generated secret; existing files are preserved.
# Public application origin, NOT the identity-provider or internal Docker origin.
NEXTAUTH_URL=http://localhost:3000
# Generate with openssl rand -base64 32; preserve across restarts/replicas.
NEXTAUTH_SECRET=your-secret-key-here

# Usersau OAuth Configuration
USERSAU_CLIENT_ID=your_client_id_here
USERSAU_CLIENT_SECRET=your_client_secret_here
# Your Users.au project's hosted login origin, e.g. https://<project>.users.au.
# It serves authentication, even when the project and application share a name.
# This is separate from NEXTAUTH_URL and its /auth/usersau/callback on your app.
# No path/trailing slash. Custom identity domains are supported; no separate issuer needed.
USERSAU_HOST=https://your-subdomain.users.au
# Leave empty for most Usersau apps. Set only if your OAuth app has explicit scopes configured.
USERSAU_SCOPE=

# Normal sign-in: all = any authenticated account in your Users.au project. No IDs needed.
# To prevent public sign-ups, disable Registration in the project's Login Flow settings.
# Existing accounts can still sign in; review them before relying on closed registration.
# Optional selected-user restriction: use allowlist with comma-separated stable Users.au IDs.
# This controls membership; add your business roles/resource permissions on the server.
USERSAU_ACCESS_MODE=all
USERSAU_ALLOWED_USER_IDS=

# Default is strict runtime patch validation, including on Vercel.
# Temporary operator-reviewed exception for Vercel-managed patch rollout only:
# USERSAU_ALLOW_MANAGED_PATCH_LAG=true
# Read VERCEL_DEPLOYMENT.md before enabling it. Never use this on self-managed hosts.

# Public Environment Variables: visible in browser bundles and fixed at build time.
# Never put private credentials here. Rebuild when these change.
NEXT_PUBLIC_APP_NAME="Next.js Usersau Starter Kit"
# Same identity-provider origin as USERSAU_HOST, not your application's origin.
NEXT_PUBLIC_USERSAU_HOST=https://your-subdomain.users.au

# Vercel Deployment (Production)
# Set NEXTAUTH_URL to your production domain when deploying
# Example: NEXTAUTH_URL=https://your-app.vercel.app
# Register exactly NEXTAUTH_URL + /auth/usersau/callback with Users.au.

# Development
NODE_ENV=development 
